# Copiar a .env y completar. .env no se versiona.

# --- MCP (cliente de OpenProject) ---
OPENPROJECT_URL=http://localhost:8080
OPENPROJECT_API_KEY=
# Opcional: URL visible para el usuario en enlaces de respuesta (por defecto http://localhost:8080)
OPENPROJECT_PUBLIC_URL=http://localhost:8080
# Opcional: tipo de work package para HU (por defecto 39) y proyecto por defecto (sirap-main)
OPENPROJECT_TYPE_ID=39
OPENPROJECT_DEFAULT_PROJECT=sirap-main

# --- Compose: OpenProject ---
# Generar con: openssl rand -hex 64
OPENPROJECT_SECRET_KEY_BASE=
# Host de OpenProject (por defecto localhost:8080)
OPENPROJECT_HOST__NAME=localhost:8080
